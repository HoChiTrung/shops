# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Aiven / Local PostgreSQL connection string.
# Set this in AI Studio Settings -> Secrets (never commit your real password to source code).
# Example (Aiven): postgres://avnadmin:YOUR_PASSWORD@pg-xxxx.aivencloud.com:27504/defaultdb?sslmode=require
DATABASE_URL=""

# Optional: Aiven CA certificate (PEM) for strict TLS verification.
# If omitted when sslmode=require is present, TLS encryption is still enforced for Aiven connections.
DATABASE_CA_CERT=""

# Optional global API key for external Agent connecting to /api/agent/* and /ws/agent.
# Each shop also generates its own per-shop Agent API Key visible in /admin.
AGENT_API_KEY=""

# Optional server-side admin bootstrap override.
# If left empty, the app presents a secure one-time setup form on first visit to /admin or /super-admin.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Optional comma-separated allowed frontend origins when hosting static Frontend on GitHub Pages
# and Backend API on Render (e.g. https://username.github.io)
CORS_ORIGIN=""

# Optional Backend API base URL for static GitHub Pages frontend builds (leave empty for same-origin)
VITE_API_BASE_URL=""
